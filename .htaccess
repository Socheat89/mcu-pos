# Security: Disable Directory Listing
Options -Indexes

RewriteEngine On

# Block sensitive files and artifacts that should never be served directly.
<FilesMatch "(^\.|composer\.(json|lock|phar)$|package(-lock)?\.json$|README\.md$|error_log$|.*\.(log|sql|zip|bak|old|swp)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

RewriteRule ^(deploy|diagnose|fix_db|migrate_gps|run_migrations|scratch_query|temp_post|test_db)\.php$ - [F,L]
RewriteRule ^test_vhost\.txt$ - [F,L]
RewriteRule ^public/(admin\.zip|error_log|logs/|api/(debug_hits|bakong_debug)\.txt)$ - [F,L]
RewriteRule ^public/api/(migrate_gps|reset_cache)\.php$ - [F,L]
RewriteRule ^(uploads|public/uploads)/.*\.(php[0-9]?|phtml|phar|pl|py|cgi|sh)$ - [F,L,NC]

# ── Detect environment ──────────────────────────────────────────────────────
# On live (domain root), RewriteBase is /.
# On local XAMPP (subfolder), RewriteBase is /Mekong_CyberUnit/.
# We auto-set it based on the server name.
# If you deploy to root on live, change to: RewriteBase /

RewriteBase /

# SEO endpoints
RewriteRule ^sitemap\.xml$ public/sitemap.php [L]
RewriteRule ^robots\.txt$ public/robots.php [L]

# Favicon shortcuts
RewriteRule ^favicon\.(ico|png)$ public/images/logo.png [L]

# Internally rewrite root to public folder
RewriteRule ^$ public/ [L]

# If request is not for public/, check if it exists in public/ and rewrite internally
RewriteCond %{REQUEST_URI} !^/public/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/public/$1 -f
RewriteRule ^(.*)$ public/$1 [L]

# Security: Block direct access to core system folders
RewriteRule ^(config|core|middleware|database|logs|vendor|modules)/(.*)$ - [F,L]

# Handle PHP files directly - Allow specific access to existing PHP files
RewriteCond %{REQUEST_FILENAME} \.php$ [NC]
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule . - [L]

# Allow access to existing files and directories (images, css, js)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule . - [L]

# Route EVERYTHING else to index.php
RewriteRule ^(.*)$ index.php [QSA,L]
